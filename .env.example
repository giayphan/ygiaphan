# ygiaphan — Script Properties สำหรับ Google Apps Script
# คัดลอกเป็น .env แล้วใส่ค่าจริง (ไม่ commit .env)

# Google Sheet ID — ได้จาก URL ของ Sheet
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GAS_SHEET_ID=PUT_YOUR_SHEET_ID_HERE

# Admin password สำหรับ login ผ่าน admin.html
GAS_ADMIN_KEY=change-me-to-something-secure

# อีเมลที่รับ OTP admin + ใช้เป็น admin account
GAS_ADMIN_EMAIL=your@email.com

# URL ของเว็บ (GitHub Pages)
GAS_SITE_URL=https://yourname.github.io/ygiaphan

# Facebook App ID (เว้นว่างถ้าไม่ใช้ Facebook Login)
GAS_FB_APP_ID=
